# Copy to .env and adjust. Every setting has a safe dev default; see app/core/config.py.
AGENTOPS_ENV=dev                      # dev | test | prod (prod refuses to start without keys/DB URL)
AGENTOPS_LOG_LEVEL=INFO
AGENTOPS_DATABASE_URL=postgresql+asyncpg://agentops:agentops@localhost:5433/agentops

# "key:tenant" pairs, comma-separated, keys >= 16 chars. Empty in dev = built-in dev keys:
#   dev-key-tenant-a -> tenant_a, dev-key-tenant-b -> tenant_b
AGENTOPS_API_KEYS=

# Local models (Ollama)
AGENTOPS_LLM_PROVIDER=ollama          # ollama | fake
AGENTOPS_OLLAMA_BASE_URL=http://localhost:11434
AGENTOPS_LLM_MODEL_MAIN=qwen3:8b
AGENTOPS_LLM_MODEL_SMALL=qwen3:1.7b
AGENTOPS_EMBEDDING_PROVIDER=ollama    # ollama | fake
AGENTOPS_EMBEDDING_MODEL=nomic-embed-text

# Optional hosted fallback (any OpenAI-compatible API). Used only on transient Ollama failures.
# Enabling it sends prompts AND retrieved document text to that provider.
# AGENTOPS_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
# AGENTOPS_FALLBACK_API_KEY=
# AGENTOPS_FALLBACK_MODEL=llama-3.1-8b-instant

# Ingestion / retrieval
AGENTOPS_CHUNK_STRATEGY=structured    # structured | fixed
AGENTOPS_CHUNK_SIZE_CHARS=1200
AGENTOPS_CHUNK_OVERLAP_CHARS=200
AGENTOPS_RETRIEVAL_TOP_K=6
