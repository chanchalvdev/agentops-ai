# Copy to .env and adjust. Every setting has a safe dev default; see app/core/config.py.
AGENTOPS_ENV=dev                      # dev | test | prod (prod refuses to start without keys/DB URL)
AGENTOPS_LOG_LEVEL=INFO
AGENTOPS_DATABASE_URL=postgresql+asyncpg://agentops:agentops@localhost:5433/agentops
# AGENTOPS_DB_PORT=5433                # docker compose host port; keep in sync with the URL above

# "key:tenant" pairs, comma-separated, keys >= 16 chars. Empty in dev = built-in dev keys:
#   dev-key-tenant-a -> tenant_a, dev-key-tenant-b -> tenant_b
AGENTOPS_API_KEYS=

# Local models (Ollama)
AGENTOPS_LLM_PROVIDER=ollama          # ollama | fake
AGENTOPS_OLLAMA_BASE_URL=http://localhost:11434
AGENTOPS_LLM_MODEL_MAIN=qwen3:8b
AGENTOPS_LLM_MODEL_SMALL=qwen3:1.7b
AGENTOPS_EMBEDDING_PROVIDER=ollama    # ollama | fake
AGENTOPS_EMBEDDING_MODEL=nomic-embed-text

# Optional hosted fallback (any OpenAI-compatible API). Used only on transient Ollama failures.
# Enabling it sends prompts AND retrieved document text to that provider.
# AGENTOPS_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
# AGENTOPS_FALLBACK_API_KEY=
# AGENTOPS_FALLBACK_MODEL=llama-3.1-8b-instant

# Ingestion / retrieval
AGENTOPS_CHUNK_STRATEGY=structured    # structured | fixed
AGENTOPS_CHUNK_SIZE_CHARS=1200
AGENTOPS_CHUNK_OVERLAP_CHARS=200
AGENTOPS_RETRIEVAL_TOP_K=6

# Agent execution limits (server defaults; a request may only tighten them)
AGENTOPS_LLM_NUM_CTX=8192             # Ollama context window; longer prompts are silently truncated
AGENTOPS_AGENT_MAX_STEPS=8            # custom loop turns
AGENTOPS_AGENT_MAX_GRAPH_STEPS=20     # LangGraph nodes executed
AGENTOPS_AGENT_MAX_MODEL_CALLS=12
AGENTOPS_AGENT_MAX_TOOL_CALLS=10
AGENTOPS_AGENT_MAX_CORRECTIONS=2      # per failure kind
AGENTOPS_AGENT_MAX_TOTAL_TOKENS=48000
# AGENTOPS_AGENT_MAX_COST_USD=0.50    # unset = no monetary cap; unknown hosted pricing fails closed
AGENTOPS_AGENT_DEADLINE_S=180
AGENTOPS_AGENT_MAX_CONTEXT_CHARS=20000
AGENTOPS_AGENT_CHECKPOINTER=postgres  # postgres | memory (memory loses pending approvals on restart)

# Sandboxed workspace (product.txt 9.1): each tenant may only touch <root>/<tenant_id>/.
# Use a disposable directory: never your home directory or a real repository.
AGENTOPS_WORKSPACE_ROOT=workspace
AGENTOPS_WORKSPACE_TENANTS=           # comma-separated; empty in dev = tenant_a, empty in prod = none
AGENTOPS_WORKSPACE_MAX_READ_BYTES=20000
AGENTOPS_WORKSPACE_MAX_WRITE_BYTES=200000
AGENTOPS_WORKSPACE_EXEC_TIMEOUT_S=60
AGENTOPS_WORKSPACE_MAX_OUTPUT_BYTES=64000

# Observability (product.txt 10). Traces always go to the local log sink; hosted backends are
# optional. Enabling one sends questions, answers, minimized tool arguments, model names, and
# timings to that vendor (never document text). Set TELEMETRY_CAPTURE_IO=false to drop text.
AGENTOPS_TELEMETRY_LOG=true
AGENTOPS_TELEMETRY_CAPTURE_IO=true
# AGENTOPS_LANGFUSE_PUBLIC_KEY=pk-lf-...
# AGENTOPS_LANGFUSE_SECRET_KEY=sk-lf-...
# AGENTOPS_LANGFUSE_HOST=https://cloud.langfuse.com
# AGENTOPS_LANGSMITH_API_KEY=lsv2_...
# AGENTOPS_LANGSMITH_PROJECT=agentops-ai
AGENTOPS_LANGSMITH_SCOPE=eval         # eval = only evaluation runs go to LangSmith | all

# Evaluation (product.txt 11)
AGENTOPS_EVAL_TENANT=eval
AGENTOPS_EVAL_DATASETS_DIR=datasets
AGENTOPS_EVAL_WORKSPACE_SEED=datasets/eval_workspace

# Optimization switches (product.txt 12). Defaults = the measured baseline; the `optimized`
# profile in datasets/experiments.json turns on the ones the Day 4 benchmark accepted.
AGENTOPS_AGENT_QUERY_REWRITE=true      # small-model search queries in addition to the question
AGENTOPS_AGENT_SEARCH_TOP_K=5          # passages per query in the graph's retrieval step
AGENTOPS_AGENT_MAX_EVIDENCE_PASSAGE_CHARS=30000  # total passage text in one answer prompt
AGENTOPS_AGENT_RULE_ROUTING=false      # code decides when tools are needed (+ calculator nudge)
AGENTOPS_AGENT_ROUTE_SIMPLE_TO_SMALL=false  # simple lookups drafted by the small model
AGENTOPS_RETRIEVAL_MODE=hybrid         # hybrid | vector | keyword
# AGENTOPS_RETRIEVAL_MIN_VECTOR_SCORE=  # unset: no relevance floor (see docs/benchmarks/day4.md)
AGENTOPS_CACHE_QUERY_EMBEDDINGS=false  # per tenant + model + query text
AGENTOPS_CACHE_TOOL_RESULTS=false      # tenant + permissions + args + corpus version + config
AGENTOPS_CACHE_TTL_S=600
AGENTOPS_CACHE_MAX_ENTRIES=1024
AGENTOPS_SEMANTIC_CACHE_ENABLED=false  # answer reuse for paraphrases; verified answers only
AGENTOPS_SEMANTIC_CACHE_MIN_SIMILARITY=0.97
# Hypothetical hosted-equivalent cost (USD per 1M tokens); unset = reported as unavailable.
# AGENTOPS_REFERENCE_PRICE_INPUT_PER_MTOK=
# AGENTOPS_REFERENCE_PRICE_OUTPUT_PER_MTOK=

# Monitoring and experiments (product.txt 13)
AGENTOPS_MONITORING_EVAL_BASELINE=datasets/baselines/golden-v1-graph-qwen3-8b-day4.json
AGENTOPS_MONITORING_RETRIEVAL_BASELINE=datasets/baselines/retrieval-golden-v1.json
AGENTOPS_MONITORING_THRESHOLDS=datasets/drift_thresholds.json
AGENTOPS_EXPERIMENTS_FILE=datasets/experiments.json
AGENTOPS_ADMIN_TENANTS=                # operators: evaluations, experiments, monitoring. Empty in dev = tenant_a

# Rate limiting: in-process token buckets per tenant (one API process; replicas need a shared store)
AGENTOPS_RATE_LIMIT_ENABLED=true
AGENTOPS_RATE_LIMIT_AGENT_PER_MIN=30
AGENTOPS_RATE_LIMIT_UPLOAD_PER_MIN=60
AGENTOPS_RATE_LIMIT_EXPENSIVE_PER_MIN=6
AGENTOPS_RATE_LIMIT_WORKSPACE_PER_MIN=120
