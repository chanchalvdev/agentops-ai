# Hosted deployment: API on Azure Container Apps, UI on Vercel, database on Neon, models on Groq.
# Copy to .env.hosted (git-ignored), fill in, then:
#   uv run python scripts/deploy_azure.py
# Names containing KEY/SECRET/TOKEN/PASSWORD/DATABASE_URL become Container Apps secrets; the rest
# become environment variables that override the defaults in deploy/container/Dockerfile.
# Full guide: docs/deployment.md

# Neon: Dashboard -> Connect -> turn "Connection pooling" OFF -> copy the URL as-is
# (postgresql://...?sslmode=require&channel_binding=require works; the app converts it).
AGENTOPS_DATABASE_URL=

# Client API keys, "key:tenant" pairs, comma-separated, each key >= 16 characters
# (make them with: openssl rand -hex 16). The demo key is public: it is built into the UI.
#   AGENTOPS_API_KEYS=<demo key>:demo,<admin key>:admin
AGENTOPS_API_KEYS=
AGENTOPS_ADMIN_TENANTS=admin
AGENTOPS_WORKSPACE_TENANTS=demo,admin,eval

# Groq (primary model): console.groq.com -> API Keys
AGENTOPS_LLM_API_KEY=
# Defaults baked into the image; uncomment to change.
# Groq's free tier: 1,000 requests/day and 8,000 tokens/minute per model, so main and small
# use different models to get two quotas. Verified 2026-11-21 (tools + JSON schema output).
# AGENTOPS_LLM_MODEL_MAIN=openai/gpt-oss-120b
# AGENTOPS_LLM_MODEL_SMALL=qwen/qwen3.8-27b

# OpenRouter (fallback on Groq 429/413/5xx): openrouter.ai -> Keys. Free model IDs end in
# ":free" and change over time; check openrouter.ai/models?q=free before deploying.
AGENTOPS_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
AGENTOPS_FALLBACK_API_KEY=
AGENTOPS_FALLBACK_MODEL=google/gemma-4-31b-it:free
AGENTOPS_FALLBACK_JSON_MODE=object

# The UI's address(es) once Vercel has deployed it, comma-separated, no trailing slash.
# AGENTOPS_CORS_ORIGINS=https://agentops-ai-demo.vercel.app

# Agent runs per minute per tenant (each run is several model calls on Groq's free quota).
AGENTOPS_RATE_LIMIT_AGENT_PER_MIN=5

# Optional tracing (sends questions, answers, model names, timings; never document text)
# AGENTOPS_LANGFUSE_PUBLIC_KEY=
# AGENTOPS_LANGFUSE_SECRET_KEY=
